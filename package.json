{
  "name": "workflow-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time backend for team workspaces and tasks (Express + Socket.io + MongoDB + Redis + JWT)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch src --watch server.js server.js",
    "seed": "node scripts/seed.js",
    "benchmark": "node scripts/benchmark.js",
    "loadtest": "node scripts/loadtest.js",
    "smoke": "node scripts/smoke.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch"
  },
  "keywords": [
    "express",
    "socket.io",
    "mongodb",
    "redis",
    "jwt",
    "realtime"
  ],
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
