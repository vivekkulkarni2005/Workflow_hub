# ---------------------------------------------------------------------------
# workflow-hub - environment template. Copy to `.env` and edit.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- infrastructure ---------------------------------------------------------
# With `docker compose up` the service names resolve inside the compose
# network. For a local run without Docker, use 127.0.0.1.
MONGODB_URI=mongodb://127.0.0.1:27017/workflow-hub
REDIS_URL=redis://127.0.0.1:6379

# Use the in-process Redis substitute instead of a real server (tests / CI).
# Never enable this in production.
REDIS_IN_MEMORY=false

# --- auth -------------------------------------------------------------------
# CHANGE BOTH. The app refuses to boot in production while they say "change-me".
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=workflow-hub

# --- cookies ----------------------------------------------------------------
COOKIE_ACCESS_NAME=wf_access
COOKIE_REFRESH_NAME=wf_refresh
# Leave empty for host-only cookies. Set to `.example.com` to share across subdomains.
COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production. Keep false for local HTTP testing.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- CORS allow-list (comma separated, no trailing slash) --------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Deliberately ~30x stricter: /auth is the brute-force surface.
RATE_LIMIT_AUTH_MAX=10

# --- security / performance -------------------------------------------------
BCRYPT_ROUNDS=10
REPORT_CACHE_TTL=60
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
SHUTDOWN_TIMEOUT_MS=10000
